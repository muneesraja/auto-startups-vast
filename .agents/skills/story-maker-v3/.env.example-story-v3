# story-maker-v3 — environment
#
# Copy this to your repo-root .env and fill in the secrets below. That's all you
# need — everything else (image sizes, qualities, providers, resolution, render
# params) has working defaults that Claude Code + the Python layer handle for you.
#
# To make a film you only give Claude Code two things: a story file and a target
# duration (e.g. 5m). This file just holds the keys it needs to spend money and
# reach your ComfyUI.
#
# Never commit real secrets. Never echo these values.

# fal.ai — required for character sheets. Get one at https://fal.ai/dashboard/keys
FAL_KEY=

# Replicate — required for storyboard sheets, location locks, and panel upscales.
# Get one at https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=

# Your ComfyUI instance for the LTX render (Stage D). Default http://localhost:8188.
COMFYUI_URL=http://localhost:8188

# Basic-auth user:pass ONLY if your ComfyUI is gated. Leave blank for a local instance.
COMFYUI_AUTH=

# Optional: only set these if you want to deviate from the locked defaults.
# STORYBOARD_IMAGE_PROVIDER defaults to replicate (gpt-image-2).
# STORYBOARD_SHEET_SIZE defaults to 3840x2160 (4K landscape).
# REPLICATE_OUTPUT_FORMAT defaults to webp (keeps 4K files ~1-3MB).
# REPLICATE_OUTPUT_COMPRESSION defaults to 90 (0-100, higher = better quality).
# REPLICATE_SHEET_QUALITY defaults to medium.