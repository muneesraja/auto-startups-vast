# =============================================================================
# Vast.ai Provisioning — Environment Variables
# =============================================================================
# Copy this to .env and fill in your values:
#   cp .env.example .env
#
# The provisioning script loads these automatically.
# These secrets are passed as env vars to every Vast.ai instance you create.
# =============================================================================

# Vast.ai API key — required for the Python SDK (replaces CLI login)
# Get yours at: https://cloud.vast.ai/manage-keys/
VAST_API_KEY=your-vast-api-key-here

# HuggingFace token — required for fast, uncapped model downloads
# Get yours at: https://huggingface.co/settings/tokens
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Discord webhook URL — for server-ready and models-ready notifications
# Create one in: Discord Server Settings → Integrations → Webhooks
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxxx/xxxx

# FRP tunnel token — shared secret between your VPS frps server and GPU instances
# Only needed if you run your own FRP server for stable tunneling
FRP_TOKEN=your-frp-token-here

# FRP server address — IP or domain of your FRP server
FRP_SERVER_ADDR=159.195.52.130

# FRP server port
FRP_SERVER_PORT=7000


FAL_KEY=
COMFYUI_URL=https://mwisf01umbfaql-8188.proxy.runpod.net
MINIMAX_API_KEY=abc
OPENROUTER_API_KEY=

# Story Maker — LLM model tiers (OpenRouter model slugs)
# Pipeline planning uses PLANNING_MODEL for story developer, scene paper, and plan.json.
# Optional overrides: STORY_DEVELOPER_MODEL, STORY_PLAN_MODEL.
# STORY_STYLE=cinematic
# STORY_STYLE=reels
# STORY_STYLE=reel_v2
# SEQUENTIAL_SHOT_PROMPTS=1
# PLANNING_MODEL=openai/gpt-5.4-mini
# PLANNING_REASONING_EFFORT=low
# STORY_PLAN_MODEL=openai/gpt-5.4-mini
# PLANNING_MODEL_TIMEOUT=600
# SECONDARY_MODEL=openai/gpt-5.4-mini
# SECONDARY_REASONING_EFFORT=low
# SECONDARY_MODEL_TIMEOUT=600
# VISION_MODEL=openai/gpt-5-mini
# CROP_ANALYSIS_MODEL=openai/gpt-5.4-mini

# Story Maker — still images via Replicate openai/gpt-image-2
# aspect_ratio accepts ratios OR Replicate pixel enums (locks resolution).
PROVIDER=replicate # locations / panel regen / shot stills
# Sheets (few calls): fal GPT Image 2 — keep high-volume shots on Replicate
STORYBOARD_IMAGE_PROVIDER=fal
# CHARACTER_SHEET_IMAGE_PROVIDER=fal  # default fal when FAL_KEY set
# Panel stills: Replicate only (fal edit+refs is ~3–4× for volume panel regen)
# PANEL_IMAGE_PROVIDER=replicate
# PANEL_IMAGE_FALLBACK_PROVIDER=none
REPLICATE_API_TOKEN=
# FAL_KEY=  # required for storyboard + character sheets on fal
# GROK_REPLICATE_MODEL=openai/gpt-image-2
# GROK_FAL_MODEL=openai/gpt-image-2
# Sheets (character + storyboard): medium @ 2K
# REPLICATE_SHEET_QUALITY=medium
# CHARACTER_SHEET_SIZE=1152x2048
# STORYBOARD_SHEET_SIZE=1152x2048
# Panel crop: python (white-gutter detect → grid) | vision | auto
# STORYBOARD_CROP_MODE=python
# Storyboard video path after panel regen:
#   fallback = existing video_shots → vision motion → I2V (default)
#   director = assistant-director I2V standalones + FLF2V continuous chains
# STORYBOARD_VIDEO_MODE=fallback
# When STORYBOARD_VIDEO_MODE=director, choose the Comfy render backend:
#   templates = legacy ltx-i2v / ltx-flf2v templates (default)
#   director_v2 = LTX Director Hotfix timeline (WhatDreamsCost)
# STORY_MAKER_VIDEO_BACKEND=templates
# FLF_DURATION_TOLERANCE_PERCENT=15
# LTX output resolution (divisible by 32; two-pass uses half-res first)
# VIDEO_WIDTH=1920
# VIDEO_HEIGHT=1088
# Panel regen / shot stills from storyboard: low @ 2K landscape
# REPLICATE_PANEL_QUALITY=low
# PANEL_IMAGE_SIZE=2048x1152
# BACKGROUND_IMAGE_SIZE=2048x1152
# REPLICATE_IMAGE_QUALITY=low
# IMAGE_REF_LIMIT=13
# Legacy fal/Grok Imagine is optional only; do not use for new runs.

