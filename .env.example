# =============================================================================
# Vast.ai Provisioning — Environment Variables
# =============================================================================
# Copy this to .env and fill in your values:
#   cp .env.example .env
#
# The provisioning script loads these automatically.
# These secrets are passed as env vars to every Vast.ai instance you create.
# =============================================================================

# HuggingFace token — required for fast, uncapped model downloads
# Get yours at: https://huggingface.co/settings/tokens
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Vast.ai API Key — required to run the Python SDK without the vast CLI
# Get yours at: https://cloud.vast.ai/account/
VAST_API_KEY=

# Discord webhook URL — for server-ready and models-ready notifications
# Create one in: Discord Server Settings → Integrations → Webhooks
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxxx/xxxx

# FRP tunnel token — shared secret between your VPS frps server and GPU instances
# Only needed if you run your own FRP server for stable tunneling
FRP_TOKEN=your-frp-token-here

# FRP server address — IP or domain of your FRP server
FRP_SERVER_ADDR=159.195.52.130

# FRP server port
FRP_SERVER_PORT=7000
