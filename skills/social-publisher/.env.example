# Social Publisher — environment variables
# Copy relevant keys to ~/.hermes/.env or project .env on the VPS.

# --- Google Sheet queue ---
# Sheet URL: https://docs.google.com/spreadsheets/d/<SHEET_ID>/edit
# See README tab in sheet for color legend and quick guide
SOCIAL_PUBLISHER_SHEET_ID=
SOCIAL_PUBLISHER_QUEUE_TAB=Queue
SOCIAL_PUBLISHER_ACCOUNTS_TAB=Accounts

# --- VPS public URL (HTTPS required for Instagram) ---
SOCIAL_PUBLISHER_PUBLIC_BASE_URL=https://your-vps.example.com
SOCIAL_PUBLISHER_MEDIA_HOST=0.0.0.0
SOCIAL_PUBLISHER_MEDIA_PORT=8765

# --- YouTube (one channel for Phase 1) ---
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=

# Per-account override (used when Accounts.credential_ref = YT_MAIN)
# YT_MAIN_CLIENT_ID=
# YT_MAIN_CLIENT_SECRET=
# YT_MAIN_REFRESH_TOKEN=

# --- Instagram (Instagram Login API — Meta dashboard "Generate token") ---
IG_APP_SECRET=              # Meta dashboard → Instagram app secret (for exchange/refresh)
IG_SHORT_LIVED_TOKEN=       # From "Generate token" (~1 hour); used to mint long-lived
IG_ACCESS_TOKEN=            # Long-lived (~60 days); skill prefers this for publish
IG_USER_ID=                 # e.g. 17841431826663169 from dashboard

# Per-account override (used when Accounts.credential_ref = IG_MAIN)
# IG_MAIN_APP_SECRET=
# IG_MAIN_SHORT_LIVED_TOKEN=
# IG_MAIN_ACCESS_TOKEN=
# IG_MAIN_USER_ID=

# --- Optional ---
SOCIAL_PUBLISHER_STALE_MINUTES=30
SOCIAL_PUBLISHER_TEMP_DIR=
SOCIAL_PUBLISHER_STATE_FILE=
GWS_BIN=gws
GOOGLE_WORKSPACE_CLI_KEYRING_BACKEND=file
IG_GRAPH_API_VERSION=v21.0
